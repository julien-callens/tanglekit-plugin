{
  "name": "tanglekit",
  "displayName": "TangleKit",
  "description": "TangleKit syntax highlighting, compiler diagnostics, snippets, and indentation for VS Code.",
  "version": "1.1.0",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tangle",
        "aliases": [
          "Tangle",
          "tangle"
        ],
        "extensions": [
          ".tangle",
          ".tngl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tangle",
        "scopeName": "source.tangle",
        "path": "./syntaxes/tangle.tmLanguage.json",
        "embeddedLanguages": {
          "source.js": "javascript"
        }
      }
    ],
    "snippets": [
      {
        "language": "tangle",
        "path": "./snippets/tangle.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/julien-callens/tanglekit-plugin.git"
  },
  "author": "Julien Callens",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tanglekit": "0.6.6",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "publisher": "JulienCallens",
  "icon": "images/icon.png",
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "build": "node build.mjs",
    "vscode:prepublish": "npm run build"
  },
  "main": "./dist/extension.cjs",
  "browser": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:tangle"
  ]
}
