{
  "Component with a prop": {
    "prefix": "tngl-component",
    "body": [
      "<props>",
      "\tlet ${1:message} = \"${2:Hello}\";",
      "</props>",
      "",
      "<${3:p}>{{ ${1} }}</${3}>$0"
    ],
    "description": "Create a component with a default prop and one root element"
  },
  "Component import": {
    "prefix": "tngl-import",
    "body": [
      "${1:Child} from './${1}.tngl';$0"
    ],
    "description": "Import a component inside an import block"
  },
  "Template conditional": {
    "prefix": "tngl-if",
    "body": [
      "{{ if (${1:condition}) }}",
      "\t${2:content}",
      "{{ else }}",
      "\t${3:alternative}",
      "{{ /if }}$0"
    ],
    "description": "Insert an if/else template block"
  },
  "Click handler": {
    "prefix": "tngl-click",
    "body": [
      "<button onClick={{ ${1:increment}() }}>${2:Click me}</button>$0"
    ],
    "description": "Call a handler when a button is clicked"
  }
}
