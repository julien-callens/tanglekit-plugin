{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Tangle",
	"scopeName": "source.tangle",
	"fileTypes": [
		"tangle",
		"tngl"
	],
	"patterns": [
		{
			"include": "#codeBlock"
		},
		{
			"include": "#propsBlock"
		},
		{
			"include": "#importBlock"
		},
		{
			"include": "#template"
		}
	],
	"repository": {
		"codeBlock": {
			"name": "meta.code.tangle",
			"begin": "(<)(code)(>)",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.tag.begin.tangle"
				},
				"2": {
					"name": "entity.name.tag.tangle"
				},
				"3": {
					"name": "punctuation.definition.tag.end.tangle"
				}
			},
			"end": "(</)(code)(>)",
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.tag.begin.tangle"
				},
				"2": {
					"name": "entity.name.tag.tangle"
				},
				"3": {
					"name": "punctuation.definition.tag.end.tangle"
				}
			},
			"contentName": "source.js",
			"patterns": [
				{
					"include": "#commonCode"
				},
				{
					"include": "source.js"
				}
			]
		},
		"propsBlock": {
			"name": "meta.props.tangle",
			"begin": "(<)(props)(>)",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.tag.begin.tangle"
				},
				"2": {
					"name": "entity.name.tag.tangle"
				},
				"3": {
					"name": "punctuation.definition.tag.end.tangle"
				}
			},
			"end": "(</)(props)(>)",
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.tag.begin.tangle"
				},
				"2": {
					"name": "entity.name.tag.tangle"
				},
				"3": {
					"name": "punctuation.definition.tag.end.tangle"
				}
			},
			"patterns": [
				{
					"include": "#commonCode"
				}
			]
		},
		"importBlock": {
			"name": "meta.import.tangle",
			"begin": "(<)(import)(>)",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.tag.begin.tangle"
				},
				"2": {
					"name": "entity.name.tag.tangle"
				},
				"3": {
					"name": "punctuation.definition.tag.end.tangle"
				}
			},
			"end": "(</)(import)(>)",
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.tag.begin.tangle"
				},
				"2": {
					"name": "entity.name.tag.tangle"
				},
				"3": {
					"name": "punctuation.definition.tag.end.tangle"
				}
			},
			"patterns": [
				{
					"match": "\\bfrom\\b",
					"name": "keyword.control.import.tangle"
				},
				{
					"include": "#string"
				},
				{
					"match": ";",
					"name": "punctuation.terminator.statement.tangle"
				},
				{
					"match": "\\b[a-zA-Z_]\\w*\\b",
					"name": "variable.import.tangle"
				}
			]
		},
		"commonCode": {
			"patterns": [
				{
					"include": "#string"
				},
				{
					"match": "//.*$",
					"name": "comment.line.double-slash.tangle"
				},
				{
					"match": "\\b(else if|if|else)\\b",
					"name": "keyword.control.conditional.tangle"
				},
				{
					"match": "\\breturn\\b",
					"name": "keyword.control.return.tangle"
				},
				{
					"match": "\\bfunction\\b",
					"name": "keyword.declaration.function.tangle"
				},
				{
					"match": "\\b(let|const)\\b",
					"name": "storage.type.variable.tangle"
				},
				{
					"match": "\\b(true|false)\\b",
					"name": "constant.language.boolean.tangle"
				},
				{
					"match": "\\b[0-9]+\\b",
					"name": "constant.numeric.tangle"
				},
				{
					"match": "\\b[A-Za-z_]\\w*(?=\\s*\\()",
					"name": "entity.name.function.tangle"
				},
				{
					"match": "\\b[A-Za-z_]\\w*\\b",
					"name": "variable.other.code.tangle"
				},
				{
					"match": "===|!==|<=|>=|&&|\\|\\|",
					"name": "keyword.operator.tangle"
				},
				{
					"match": "[+*/-]?=|\\+\\+|--",
					"name": "keyword.operator.assignment.tangle"
				},
				{
					"match": "[<>+*/%!-]",
					"name": "keyword.operator.tangle"
				},
				{
					"match": ";",
					"name": "punctuation.terminator.statement.tangle"
				},
				{
					"match": "[()]",
					"name": "punctuation.definition.group.tangle"
				}
			]
		},
		"template": {
			"name": "meta.template.tangle",
			"begin": "(?=<)",
			"end": "(?!)",
			"patterns": [
				{
					"include": "#tag"
				},
				{
					"include": "#interpolation"
				},
				{
					"match": "[^<{]+",
					"name": "text.html.basic.tangle"
				}
			]
		},
		"tag": {
			"name": "meta.tag.tangle",
			"begin": "(</?)\\s*([A-Za-z_]\\w*)",
			"end": "/\\s*>|>",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.tag.begin.tangle"
				},
				"2": {
					"name": "entity.name.tag.tangle"
				}
			},
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.tag.end.tangle"
				}
			},
			"patterns": [
				{
					"match": "[A-Za-z_]\\w*",
					"name": "entity.other.attribute-name.tangle"
				},
				{
					"match": "=",
					"name": "keyword.operator.assignment.tangle"
				},
				{
					"include": "#string"
				},
				{
					"include": "#interpolation"
				}
			]
		},
		"interpolation": {
			"name": "meta.embedded.tangle",
			"begin": "\\{\\{",
			"end": "\\}\\}",
			"contentName": "source.js",
			"patterns": [
				{
					"match": "/if\\b",
					"name": "keyword.control.conditional.tangle"
				},
				{
					"include": "#commonCode"
				},
				{
					"include": "source.js"
				}
			]
		},
		"string": {
			"name": "string.quoted.tangle",
			"begin": "([\"'])",
			"end": "\\1"
		}
	}
}
