{
    "comments": {
        "lineComment": "//"
    },
    "brackets": [
        [
            "{{",
            "}}"
        ],
        [
            "{",
            "}"
        ],
        [
            "[",
            "]"
        ],
        [
            "(",
            ")"
        ]
    ],
    "autoClosingPairs": [
        [
            "{{",
            "}}"
        ],
        [
            "{",
            "}"
        ],
        [
            "[",
            "]"
        ],
        [
            "(",
            ")"
        ],
        [
            "\"",
            "\""
        ],
        [
            "'",
            "'"
        ]
    ],
    "surroundingPairs": [
        [
            "{",
            "}"
        ],
        [
            "[",
            "]"
        ],
        [
            "(",
            ")"
        ],
        [
            "\"",
            "\""
        ],
        [
            "'",
            "'"
        ]
    ],
    "wordPattern": "[A-Za-z_][A-Za-z0-9_]*",
    "indentationRules": {
        "increaseIndentPattern": "^\\s*(?:<[A-Za-z_]\\w*\\b[^<>]*(?<!/)>\\s*|\\{\\{\\s*(?:if\\b|else\\b).*?\\}\\}\\s*|.*\\{\\s*)$",
        "decreaseIndentPattern": "^\\s*(?:</|\\{\\{\\s*(?:/if\\b|else\\b)|\\})"
    }
}
